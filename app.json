{
  "expo": {
    "name": "PeriOp SAHISC",
    "slug": "periop-sahisc",
    "owner": "trictracxliv",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "periopsahisc",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.sahisc.periop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "br.com.sahisc.periop"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/periop-sahisc"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3239265a-27a0-4523-a89d-db2492e1be83"
      }
    }
  }
}
